# ===== Database Neon PostgreSQL =====
# Ambil dari Neon Console → Project → Connect → Connection string (pooled).
# Pada Vercel, wajib ada di environment Preview (dan Production saat siap).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ===== Proteksi endpoint import Line Haul =====
# String acak panjang (mis. hasil `openssl rand -hex 32`).
# Dipakai sebagai header: x-line-haul-import-key
LINE_HAUL_IMPORT_KEY=""

# ===== Google Sheets (sumber jadwal Line Haul) =====
# Buat Service Account di Google Cloud Console, lalu bagikan spreadsheet
# ke email service account tersebut dengan akses Viewer.
GOOGLE_SHEETS_CLIENT_EMAIL="linehaul@PROYEK.iam.gserviceaccount.com"
# Private key PEM disimpan SATU BARIS; ganti newline dengan literal \n.
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID="ID-dari-URL-sheets"
GOOGLE_SHEETS_TAB_NAME="Padang DC"
